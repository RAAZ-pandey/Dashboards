      <column caption='Assets' datatype='string' name='[ASSETS]' role='dimension' type='nominal' />
      <column caption='Category' datatype='string' name='[CATEGORY]' role='dimension' type='nominal' />
      <column caption='Criminal Cases' datatype='integer' name='[CRIMINAL CASES]' role='dimension' type='ordinal' />
      <column caption='Total Votes Cast' datatype='integer' name='[Calculation_1571474863274082304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Votes])' />
      </column>
      <column caption='Total Candidates' datatype='integer' name='[Calculation_1571474863274528769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Candidate])' />
      </column>
      <column caption='Parties Participated' datatype='integer' name='[Calculation_1571474863274745858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Party])' />
      </column>
      <column caption='Winning Candidates' datatype='string' name='[Calculation_1571474863286558726]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Winner] = 1 THEN [Candidate] END' />
      </column>
      <column caption='Ranked Parties' datatype='integer' name='[Calculation_1571474863294910471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Total Votes]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top N filter' datatype='string' name='[Calculation_1571474863295426568]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK(SUM([Total Votes]), &apos;desc&apos;) &lt;= [Parameters].[Parameter 1] THEN &quot;Show&quot; ELSE &quot;Hide&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Votes Percentage' datatype='real' name='[Calculation_1571474863296794633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Votes])/TOTAL(SUM([Total Votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dummy' datatype='integer' name='[Calculation_787285511606149120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='winning rate' datatype='real' name='[Calculation_787285511942127617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Winning Rate' datatype='real' name='[Calculation_787285511942340610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Winner]) / COUNT([Candidate]) * 100' />
      </column>
      <column caption='Candidates per Party' datatype='integer' name='[Calculation_787285511947452419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Candidate])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_787285511952433156]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 26 THEN &quot;18-25&quot;&#13;&#10;ELSEIF [Age] &lt; 41 THEN &quot;26-40&quot;&#13;&#10;ELSEIF [Age] &lt; 61 THEN &quot;41-60&quot;&#13;&#10;ELSE &quot;60+&quot;&#13;&#10;END' />
      </column>
      <column caption='Percentage of total votes' datatype='real' name='[Calculation_787285511953977349]' role='measure' type='quantitative'>
