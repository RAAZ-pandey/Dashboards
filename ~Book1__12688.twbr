      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0l48i4p169rord10mpow21ptv2f1].[sum:Winner:qk]&quot;' value='Winner candidates' />
        </aliases>
