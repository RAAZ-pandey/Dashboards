      <aliases enabled='yes' />
      <column caption='Assets' datatype='string' name='[ASSETS]' role='dimension' type='nominal' />
      <column caption='Category' datatype='string' name='[CATEGORY]' role='dimension' type='nominal' />
      <column caption='Criminal Cases' datatype='string' name='[CRIMINAL CASES]' role='dimension' type='nominal' />
      <column caption='is Winner' datatype='boolean' name='[Calculation_1238771375252180994]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Total Votes] = [Calculation_1238771375322914823]' />
      </column>
      <column caption='Age group' datatype='string' name='[Calculation_1238771375310983174]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &gt;= 18 AND [Age] &lt;= 25 THEN &quot;18–25&quot;&#13;&#10;ELSEIF [Age] &gt;= 26 AND [Age] &lt;= 35 THEN &quot;26–35&quot;&#13;&#10;ELSEIF [Age] &gt;= 36 AND [Age] &lt;= 45 THEN &quot;36–45&quot;&#13;&#10;ELSEIF [Age] &gt;= 46 AND [Age] &lt;= 60 THEN &quot;46–60&quot;&#13;&#10;ELSEIF [Age] &gt; 60 THEN &quot;60+&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Max votes per constituency' datatype='integer' name='[Calculation_1238771375322914823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Constituency]: MAX([Total Votes]) }' />
      </column>
      <column caption='IS winners' datatype='boolean' name='[Calculation_1238771375323275272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Total Votes] = [Calculation_1238771375322914823]' />
      </column>
